# ---------------------------------------------------------------------------
# Nile Mart environment configuration
# Copy to `.env` at the repository root and fill in the values you need.
# Only development defaults are provided. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public origin of the storefront (used for links, redirects and origin checks)
APP_URL=http://localhost:5173
# Public origin of the API (must be reachable by payment providers for webhooks)
API_URL=http://localhost:4000

# Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PostgreSQL engine (PGlite)
# stored in server/data. Set a standard Postgres connection string (Supabase,
# Neon, RDS...) for production deployments.
DATABASE_URL=
# Postgres SSL: disable | require | no-verify (default require when URL is set)
DATABASE_SSL=require
PGLITE_DATA_DIR=./data

# Uploads ----------------------------------------------------------------
# In production point this at a persistent volume (for example /data/uploads)
UPLOADS_DIR=./server/uploads

# Sessions ---------------------------------------------------------------
SESSION_COOKIE_NAME=nm_session
SESSION_TTL_DAYS=30

# Transactional email (optional). Without SMTP the app stores messages in the
# email_outbox table and logs them; development exposes verification links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nile Mart <no-reply@nilemart.et>
ORDER_NOTIFICATION_EMAIL=orders@nilemart.et

# Payments ---------------------------------------------------------------
# Cash on delivery is enabled by default.
PAYMENTS_COD_ENABLED=true
# Chapa (Ethiopian gateway). Sandbox keys: https://dashboard.chapa.co
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1
# Optional providers - only enabled when credentials are supplied and tested.
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_PRIVATE_KEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
EPS_MERCHANT_ID=
EPS_MERCHANT_KEY=

# Operations -------------------------------------------------------------
# Minutes an online order may stay unpaid before stock reservations expire.
RESERVATION_MINUTES=120
# Block checkout for unverified email addresses (recommended: true)
REQUIRE_VERIFIED_EMAIL=false
# Rate limit window (ms) and multiplier for sensitive endpoints
RATE_LIMIT_WINDOW_MS=60000
# Seed demo catalogue/products (development only)
SEED_DEMO_DATA=true
# Demo admin password created by the seed (development only)
SEED_ADMIN_PASSWORD=NileMart#2026
